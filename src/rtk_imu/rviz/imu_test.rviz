Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
    - Class: rviz_default_plugins/Pose
      Name: IMU Orientation
      Enabled: true
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /imu_pose
      Shape: Arrow
      Color: 255; 25; 0
      Alpha: 1
      Shaft Length: 1.0
      Shaft Radius: 0.05
      Head Length: 0.2
      Head Radius: 0.1
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Name: Current View
Window Geometry:
  Height: 800
  Width: 1200
