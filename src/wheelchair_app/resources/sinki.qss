/* 沉墨 Deep Ink — 智慧轮椅统一视觉规范 */

QMainWindow, QWidget {
    background-color: #0F1219;
    color: #E8E4DC;
    font-family: "Inter", "Noto Sans SC", sans-serif;
    font-size: 13px;
}

/* 顶部 tab 栏 */
QTabWidget::pane {
    border: 1px solid rgba(212,165,116,0.12);
    border-top: none;
    background: #0F1219;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: rgba(255,255,255,0.025);
    color: #8A7D68;
    border: 1px solid rgba(212,165,116,0.12);
    border-bottom: none;
    padding: 10px 28px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 130px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: rgba(212,165,116,0.12);
    color: #D4A574;
    border-color: #D4A574;
}

QTabBar::tab:hover:!selected {
    color: #B8A98E;
    background: rgba(212,165,116,0.05);
}

/* 状态栏 */
QStatusBar {
    background: #050608;
    color: #B8A98E;
    border-top: 1px solid rgba(212,165,116,0.12);
}

QStatusBar QLabel {
    color: #B8A98E;
    padding: 0 8px;
}

/* 按钮通用 */
QPushButton {
    background: rgba(212,165,116,0.08);
    color: #D4A574;
    border: 1px solid rgba(212,165,116,0.25);
    padding: 6px 16px;
    border-radius: 7px;
    min-width: 80px;
}

QPushButton:hover {
    background: rgba(212,165,116,0.18);
    border-color: #D4A574;
}

QPushButton:pressed {
    background: rgba(212,165,116,0.28);
}

/* QGroupBox(脑电用) */
QGroupBox {
    border: 1px solid rgba(212,165,116,0.12);
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    color: #B8A98E;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #D4A574;
}

/* QProgressBar */
QProgressBar {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(212,165,116,0.12);
    border-radius: 4px;
    text-align: center;
    color: #E8E4DC;
}

QProgressBar::chunk {
    background: #D4A574;
    border-radius: 3px;
}

/* QLabel 默认 */
QLabel {
    color: #E8E4DC;
    background: transparent;
}
