<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheelchair_app</name>
  <version>0.1.0</version>
  <description>智慧轮椅主应用(PyQt5 + Web 混合架构)</description>
  <maintainer email="dev@braincontrol.local">BrainControl Developer</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rtk_frontend</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>rtk_msgs</exec_depend>
  <exec_depend>ladar_ai</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
